<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1"><style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Pony's Word Match!</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Work+Sans:wght@400;500;600;700;800&display=swap">
<style>
  :root{
    --sky-top:#7fd3ff;
    --sky-bottom:#bdeaff;
    --sun:#ffd23f;
    --card-back-1:#a05cff;
    --card-back-2:#6a3fd8;
    --pink:#ff6fae;
    --purple:#8b5cf6;
    --green:#4fd671;
    --yellow:#ffd23f;
    --orange:#ff9f43;
    --blue:#4fb8ff;
    --ink:#2c2450;
    --white:#ffffff;
    --panel:#ffffffcc;
    --font-display:'Bebas Neue', 'Arial Narrow', sans-serif;
    --font-body:'Work Sans', 'Segoe UI', sans-serif;
  }
  *{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  html,body{
    margin:0; padding:0; min-height:100%;
    font-family:var(--font-body);
    color:var(--ink);
    background:
      radial-gradient(circle at 85% 8%, #fff6c8 0%, rgba(255,246,200,0) 22%),
      linear-gradient(180deg, var(--sky-top) 0%, var(--sky-bottom) 55%, #e8fff0 100%);
    overflow-x:hidden;
    min-height:100vh;
  }

  /* ---------- Decorative background ---------- */
  .sky-decor{ position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden; }
  .cloud{
    position:absolute; font-size:44px; opacity:.85; filter:drop-shadow(0 4px 2px rgba(0,0,0,.05));
    animation:drift 60s linear infinite;
  }
  .cloud.c1{ top:6%; left:-10%; animation-duration:70s; }
  .cloud.c2{ top:16%; left:-15%; font-size:32px; animation-duration:50s; animation-delay:-15s; }
  .cloud.c3{ top:3%; left:-20%; font-size:56px; animation-duration:90s; animation-delay:-40s; }
  @keyframes drift{ from{ transform:translateX(0); } to{ transform:translateX(140vw); } }
  .star{ position:absolute; opacity:.7; animation:twinkle 2.4s ease-in-out infinite; }
  @keyframes twinkle{ 0%,100%{ opacity:.3; transform:scale(.8);} 50%{ opacity:.9; transform:scale(1);} }
  .sun-badge{
    position:fixed; top:-40px; right:-40px; font-size:120px; opacity:.9; z-index:0;
    filter:drop-shadow(0 0 20px rgba(255,210,63,.6));
  }

  .wrap{ position:relative; z-index:1; max-width:960px; margin:0 auto; padding:14px 14px 40px; }

  /* ---------- Header ---------- */
  header{
    text-align:center; padding:10px 6px 4px;
  }
  h1{
    margin:4px 0 2px; font-size:clamp(32px,7vw,54px); color:var(--purple);
    font-family:var(--font-display); letter-spacing:.03em;
    text-shadow: 3px 3px 0 #fff, -1px -1px 0 #fff, 1px -1px 0 #fff, -1px 1px 0 #fff;
  }
  h1 .horse{ display:inline-block; animation:bob 2.2s ease-in-out infinite; }
  @keyframes bob{ 0%,100%{ transform:translateY(0) rotate(-4deg);} 50%{ transform:translateY(-8px) rotate(4deg);} }
  .subtitle{ font-size:clamp(14px,2.6vw,18px); color:#5a4a8a; margin:0 0 10px; }

  /* ---------- Control panel ---------- */
  .panel{
    background:var(--panel); border-radius:26px; padding:14px 16px;
    box-shadow:0 8px 0 #d9d2f5, 0 10px 20px rgba(80,60,150,.15);
    margin-bottom:18px;
  }
  .control-row{
    display:flex; flex-wrap:wrap; gap:8px; align-items:center; justify-content:center;
    margin-bottom:10px;
  }
  .control-row:last-child{ margin-bottom:0; }
  .control-label{
    font-family:var(--font-display); letter-spacing:.02em;
    font-weight:normal; color:#6a4c93; font-size:15px; min-width:78px; text-align:right;
    margin-right:2px;
  }
  button.chip{
    font-family:var(--font-body); cursor:pointer; border:none; border-radius:999px;
    padding:9px 16px; font-size:15px; font-weight:700; color:#fff;
    background:linear-gradient(180deg,#b9a6ff,#8b5cf6);
    box-shadow:0 4px 0 #6a3fc0;
    transition:transform .08s ease, box-shadow .08s ease;
    white-space:nowrap;
  }
  button.chip:active{ transform:translateY(3px); box-shadow:0 1px 0 #6a3fc0; }
  button.chip.active{
    background:linear-gradient(180deg,#ffd76a,#ff9f43);
    box-shadow:0 4px 0 #d97a12;
    color:#4a2e00;
  }
  button.chip.mode-btn{ font-size:16px; padding:11px 20px; }
  button.chip.sound-btn{
    background:linear-gradient(180deg,#7fe3a0,#4fd671); box-shadow:0 4px 0 #2fae4d;
  }
  button.chip.sound-btn.muted{
    background:linear-gradient(180deg,#ffb3b3,#ff6f6f); box-shadow:0 4px 0 #d94a4a;
  }
  button.chip.newgame-btn{
    background:linear-gradient(180deg,#ff9fcb,#ff6fae); box-shadow:0 4px 0 #d94488;
  }

  /* ---------- Board ---------- */
  .board-shell{ display:flex; justify-content:center; }
  .board{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:12px;
    width:100%;
    max-width:680px;
    perspective:1200px;
  }
  @media (max-width:480px){
    .board{ grid-template-columns:repeat(2,1fr); gap:10px; }
  }
  @media (min-width:481px) and (max-width:640px){
    .board{ grid-template-columns:repeat(3,1fr); }
  }

  .card{
    position:relative;
    aspect-ratio:1/1;
    cursor:pointer;
    perspective:1000px;
  }
  .card-inner{
    position:relative; width:100%; height:100%;
    transform-style:preserve-3d;
    transition:transform .5s cubic-bezier(.4,.2,.2,1);
  }
  .card.flipped .card-inner{ transform:rotateY(180deg); }
  .card.matched .card-inner{ transform:rotateY(180deg); }
  .card.shake .card-inner{ animation:shake .4s ease; }
  @keyframes shake{
    0%,100%{ transform:rotateY(180deg) translateX(0); }
    25%{ transform:rotateY(180deg) translateX(-6px); }
    75%{ transform:rotateY(180deg) translateX(6px); }
  }

  .face{
    position:absolute; inset:0; backface-visibility:hidden;
    border-radius:18px; display:flex; align-items:center; justify-content:center;
    overflow:hidden;
    box-shadow:0 5px 0 rgba(0,0,0,.15), 0 6px 14px rgba(0,0,0,.12);
  }
  .face-back{
    background:linear-gradient(145deg, var(--card-back-1), var(--card-back-2));
    border:4px solid #fff;
  }
  .face-back .horse-mark{ filter:drop-shadow(0 2px 2px rgba(0,0,0,.25)); line-height:1; }
  .face-back .deco-star{
    position:absolute; color:#ffe27a; opacity:.85;
  }
  .face-front{
    background:#fff;
    border:4px solid var(--yellow);
    transform:rotateY(180deg);
    flex-direction:column;
    padding:4%;
  }
  .card.matched .face-front{
    border-color:var(--green);
    background:#eaffef;
  }
  .face-front .emoji-display{
    line-height:1;
    user-select:none;
  }
  .face-front .word-display{
    font-family:var(--font-body);
    line-height:1;
    font-weight:700;
    color:#4a2e8a;
    white-space:nowrap;
    user-select:none;
  }
  .card.matched .word-display{ color:#1f8a3d; }

  .card:not(.flipped):not(.matched):hover .card-inner{
    transform:scale(1.04) rotateZ(-1deg);
  }

  /* ---------- Celebration ---------- */
  .celebrate-overlay{
    position:fixed; inset:0; background:rgba(60,30,110,.55);
    display:none; align-items:center; justify-content:center; z-index:50;
    padding:20px;
  }
  .celebrate-overlay.show{ display:flex; }
  .celebrate-card{
    background:#fff; border-radius:28px; padding:34px 28px; text-align:center;
    box-shadow:0 12px 0 #d9d2f5, 0 16px 30px rgba(0,0,0,.25);
    max-width:420px; animation:pop .4s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes pop{ from{ transform:scale(.5); opacity:0;} to{ transform:scale(1); opacity:1;} }
  .celebrate-card h2{ font-family:var(--font-display); letter-spacing:.02em; font-size:clamp(30px,6vw,42px); color:var(--pink); margin:0 0 6px; }
  .celebrate-card p{ font-size:18px; color:#5a4a8a; margin:0 0 18px; }
  .celebrate-emojis{ font-size:44px; margin-bottom:10px; }

  footer{ text-align:center; font-size:12px; color:#7a6aa6; padding:16px 0 4px; }
</style>
</head>
<body>

<div class="sky-decor" aria-hidden="true">
  <div class="cloud c1">☁️</div>
  <div class="cloud c2">☁️</div>
  <div class="cloud c3">☁️</div>
  <div class="star" style="top:10%; left:20%; font-size:20px;">✨</div>
  <div class="star" style="top:22%; left:60%; font-size:16px; animation-delay:.6s;">⭐</div>
  <div class="star" style="top:30%; left:35%; font-size:14px; animation-delay:1.1s;">✨</div>
</div>
<div class="sun-badge" aria-hidden="true">🌞</div>

<div class="wrap">
  <header>
    <h1><span class="horse">🐴</span> Pony's Word Match! <span class="horse">🐴</span></h1>
    <p class="subtitle">Flip two cards and find the matching pair!</p>
  </header>

  <div class="panel">
    <div class="control-row">
      <button class="chip mode-btn" id="mode-picture" data-mode="picture">🖼️ Picture + Word</button>
      <button class="chip mode-btn" id="mode-tricky" data-mode="tricky">✨ Tricky Words</button>
    </div>

    <div class="control-row" id="category-row">
      <span class="control-label">Category:</span>
      <button class="chip cat-btn" data-cat="animals">🐶 Animals</button>
      <button class="chip cat-btn" data-cat="food">🍎 Food</button>
      <button class="chip cat-btn" data-cat="body">👕 Body</button>
      <button class="chip cat-btn" data-cat="home">🛏️ Home &amp; School</button>
      <button class="chip cat-btn" data-cat="transport">🚗 Transport &amp; Toys</button>
    </div>

    <div class="control-row">
      <span class="control-label">Pairs:</span>
      <button class="chip diff-btn" data-pairs="4">4</button>
      <button class="chip diff-btn" data-pairs="6">6</button>
      <button class="chip diff-btn" data-pairs="8">8</button>
    </div>

    <div class="control-row">
      <button class="chip sound-btn" id="sound-toggle">🔊 Sound: On</button>
      <button class="chip newgame-btn" id="new-game-btn">🔄 New Game</button>
    </div>
  </div>

  <div class="board-shell">
    <div class="board" id="board"></div>
  </div>

  <footer>Made with love for little learners 🐴💛</footer>
</div>

<div class="celebrate-overlay" id="celebrate-overlay">
  <div class="celebrate-card">
    <div class="celebrate-emojis">🎉🐴🎉</div>
    <h2>Great Job!</h2>
    <p>You matched them all! You're a super star reader!</p>
    <button class="chip newgame-btn" id="celebrate-newgame-btn">🔄 Play Again</button>
  </div>
</div>

<script>
/* =========================================================================
   WORD BANKS
   Add new words to these lists to expand the game — no other code needs
   to change. Each picture-word entry needs a matching emoji and word.
   ========================================================================= */

const PICTURE_WORD_BANKS = {
  animals: [
    { word: "dog", emoji: "🐶" }, { word: "cat", emoji: "🐱" },
    { word: "cow", emoji: "🐄" }, { word: "pig", emoji: "🐷" },
    { word: "sheep", emoji: "🐑" }, { word: "horse", emoji: "🐴" },
    { word: "duck", emoji: "🦆" }, { word: "chicken", emoji: "🐔" },
    { word: "rabbit", emoji: "🐰" }, { word: "monkey", emoji: "🐒" },
    { word: "elephant", emoji: "🐘" }, { word: "giraffe", emoji: "🦒" },
    { word: "tiger", emoji: "🐯" }, { word: "hippo", emoji: "🦛" },
    { word: "frog", emoji: "🐸" }, { word: "fish", emoji: "🐟" },
    { word: "bird", emoji: "🐦" }, { word: "mouse", emoji: "🐭" },
    { word: "snake", emoji: "🐍" }, { word: "crocodile", emoji: "🐊" }
  ],
  food: [
    { word: "apple", emoji: "🍎" }, { word: "banana", emoji: "🍌" },
    { word: "orange", emoji: "🍊" }, { word: "watermelon", emoji: "🍉" },
    { word: "grape", emoji: "🍇" }, { word: "mango", emoji: "🥭" },
    { word: "pineapple", emoji: "🍍" }, { word: "pear", emoji: "🍐" },
    { word: "lemon", emoji: "🍋" }, { word: "bread", emoji: "🍞" },
    { word: "cheese", emoji: "🧀" }, { word: "egg", emoji: "🥚" },
    { word: "milk", emoji: "🥛" }, { word: "rice", emoji: "🍚" },
    { word: "pizza", emoji: "🍕" }, { word: "burger", emoji: "🍔" },
    { word: "fries", emoji: "🍟" }, { word: "cake", emoji: "🎂" },
    { word: "chocolate", emoji: "🍫" }, { word: "ice cream", emoji: "🍦" }
  ],
  body: [
    { word: "eye", emoji: "👁️" }, { word: "ear", emoji: "👂" },
    { word: "nose", emoji: "👃" }, { word: "mouth", emoji: "👄" },
    { word: "hand", emoji: "✋" }, { word: "foot", emoji: "🦶" },
    { word: "leg", emoji: "🦵" }, { word: "arm", emoji: "💪" },
    { word: "tooth", emoji: "🦷" }, { word: "finger", emoji: "👆" },
    { word: "hat", emoji: "🎩" }, { word: "shirt", emoji: "👕" },
    { word: "shoe", emoji: "👞" }, { word: "sock", emoji: "🧦" },
    { word: "dress", emoji: "👗" }, { word: "coat", emoji: "🧥" },
    { word: "glasses", emoji: "👓" }, { word: "boot", emoji: "🥾" },
    { word: "watch", emoji: "⌚" }, { word: "bag", emoji: "👜" }
  ],
  home: [
    { word: "bed", emoji: "🛏️" }, { word: "chair", emoji: "🪑" },
    { word: "door", emoji: "🚪" }, { word: "window", emoji: "🪟" },
    { word: "lamp", emoji: "💡" }, { word: "phone", emoji: "📱" },
    { word: "television", emoji: "📺" }, { word: "sofa", emoji: "🛋️" },
    { word: "clock", emoji: "🕐" }, { word: "book", emoji: "📖" },
    { word: "pencil", emoji: "✏️" }, { word: "ruler", emoji: "📏" },
    { word: "crayon", emoji: "🖍️" }, { word: "computer", emoji: "💻" },
    { word: "bath", emoji: "🛁" }, { word: "house", emoji: "🏠" },
    { word: "key", emoji: "🔑" }, { word: "mirror", emoji: "🪞" },
    { word: "picture", emoji: "🖼️" }, { word: "notebook", emoji: "📓" }
  ],
  transport: [
    { word: "car", emoji: "🚗" }, { word: "bus", emoji: "🚌" },
    { word: "train", emoji: "🚆" }, { word: "bike", emoji: "🚲" },
    { word: "boat", emoji: "⛵" }, { word: "plane", emoji: "✈️" },
    { word: "ship", emoji: "🚢" }, { word: "truck", emoji: "🚚" },
    { word: "helicopter", emoji: "🚁" }, { word: "motorbike", emoji: "🏍️" },
    { word: "ball", emoji: "⚽" }, { word: "teddy bear", emoji: "🧸" },
    { word: "kite", emoji: "🪁" }, { word: "robot", emoji: "🤖" },
    { word: "guitar", emoji: "🎸" }, { word: "piano", emoji: "🎹" },
    { word: "drum", emoji: "🥁" }, { word: "doll", emoji: "🪆" },
    { word: "balloon", emoji: "🎈" }, { word: "puzzle", emoji: "🧩" }
  ]
};

// Tricky / sight words: can't be sounded out phonetically, so cards are
// identical word twins (word matches the same word) rather than a picture.
const TRICKY_WORDS = [
  "the", "a", "is", "are", "you", "was", "were", "have",
  "does", "said", "some", "one", "come", "want", "like", "look",
  "who", "of", "my", "they", "we", "no", "all", "your"
];

/* =========================================================================
   GAME STATE
   ========================================================================= */

let state = {
  mode: "picture",      // "picture" | "tricky"
  category: "animals",
  pairCount: 6,
  soundOn: true,
  cards: [],
  flippedIds: [],
  matchedCount: 0,
  totalPairs: 0,
  lockBoard: false
};

const boardEl = document.getElementById("board");
const celebrateOverlay = document.getElementById("celebrate-overlay");

/* =========================================================================
   DECK BUILDING
   ========================================================================= */

function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function buildDeck() {
  const cards = [];

  if (state.mode === "picture") {
    const bank = shuffle(PICTURE_WORD_BANKS[state.category]).slice(0, state.pairCount);
    bank.forEach((entry, idx) => {
      cards.push({ id: `${idx}-emoji`, pairId: idx, kind: "emoji", value: entry.emoji, word: entry.word });
      cards.push({ id: `${idx}-word`, pairId: idx, kind: "word", value: entry.word, word: entry.word });
    });
  } else {
    const bank = shuffle(TRICKY_WORDS).slice(0, state.pairCount);
    bank.forEach((word, idx) => {
      cards.push({ id: `${idx}-a`, pairId: idx, kind: "word", value: word, word: word });
      cards.push({ id: `${idx}-b`, pairId: idx, kind: "word", value: word, word: word });
    });
  }

  return shuffle(cards).map(c => ({ ...c, flipped: false, matched: false }));
}

/* =========================================================================
   RENDERING
   ========================================================================= */

function renderBoard() {
  boardEl.innerHTML = "";

  state.cards.forEach(card => {
    const cardEl = document.createElement("div");
    cardEl.className = "card";
    cardEl.dataset.id = card.id;

    cardEl.innerHTML = `
      <div class="card-inner">
        <div class="face face-back">
          <span class="deco-star" style="top:8%; left:10%; font-size:14px;">✨</span>
          <span class="deco-star" style="bottom:10%; right:12%; font-size:12px;">⭐</span>
          <span class="horse-mark">🐴</span>
        </div>
        <div class="face face-front">
          ${card.kind === "emoji"
            ? `<span class="emoji-display">${card.value}</span>`
            : `<span class="word-display">${card.value}</span>`}
        </div>
      </div>
    `;

    cardEl.addEventListener("click", () => onCardClick(card.id));
    boardEl.appendChild(cardEl);
  });

  // Called directly (not via requestAnimationFrame) so sizing is correct
  // immediately, even in backgrounded/inactive tabs where rAF is throttled.
  fitAllCardVisuals();
}

/* =========================================================================
   DYNAMIC SIZING
   Emoji size = ~50% of the card's actual rendered width (measured live).
   Word size = largest font that fits on one line (measured with canvas).
   ========================================================================= */

const measureCanvas = document.createElement("canvas");
const measureCtx = measureCanvas.getContext("2d");

const MAX_WORD_FONT = 54;
const MIN_WORD_FONT = 14;

function fitWordFontSize(text, maxWidthPx) {
  for (let size = MAX_WORD_FONT; size >= MIN_WORD_FONT; size -= 1) {
    measureCtx.font = `700 ${size}px "Work Sans","Segoe UI",sans-serif`;
    const width = measureCtx.measureText(text).width;
    if (width <= maxWidthPx) return size;
  }
  return MIN_WORD_FONT;
}

function fitAllCardVisuals() {
  const cardEls = boardEl.querySelectorAll(".card");
  cardEls.forEach(cardEl => {
    const rect = cardEl.getBoundingClientRect();
    if (rect.width === 0) return;

    const emojiSpan = cardEl.querySelector(".emoji-display");
    if (emojiSpan) {
      emojiSpan.style.fontSize = `${rect.width * 0.5}px`;
    }

    const horseSpan = cardEl.querySelector(".horse-mark");
    if (horseSpan) {
      horseSpan.style.fontSize = `${rect.width * 0.5}px`;
    }

    const wordSpan = cardEl.querySelector(".word-display");
    if (wordSpan) {
      const availableWidth = rect.width * 0.86; // padding allowance
      const size = fitWordFontSize(wordSpan.textContent, availableWidth);
      wordSpan.style.fontSize = `${size}px`;
    }
  });
}

let resizeTimer = null;
window.addEventListener("resize", () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(fitAllCardVisuals, 120);
});

/* =========================================================================
   SPEECH
   ========================================================================= */

let cachedVoice = null;
function pickVoice() {
  const voices = window.speechSynthesis ? window.speechSynthesis.getVoices() : [];
  cachedVoice = voices.find(v => v.lang === "en-GB") ||
                voices.find(v => v.lang && v.lang.startsWith("en")) ||
                null;
}
if (window.speechSynthesis) {
  pickVoice();
  window.speechSynthesis.onvoiceschanged = pickVoice;
}

function speak(text) {
  if (!state.soundOn || !window.speechSynthesis) return;
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = "en-GB";
  utter.rate = 0.8;
  utter.pitch = 1.05;
  if (cachedVoice) utter.voice = cachedVoice;
  window.speechSynthesis.speak(utter);
}

/* =========================================================================
   GAME LOGIC
   ========================================================================= */

function onCardClick(id) {
  if (state.lockBoard) return;
  const card = state.cards.find(c => c.id === id);
  if (!card || card.flipped || card.matched) return;
  if (state.flippedIds.length >= 2) return;

  card.flipped = true;
  state.flippedIds.push(id);
  const cardEl = boardEl.querySelector(`[data-id="${id}"]`);
  if (cardEl) cardEl.classList.add("flipped");

  if (state.flippedIds.length === 2) {
    state.lockBoard = true;
    setTimeout(evaluateFlippedPair, 650);
  }
}

function evaluateFlippedPair() {
  const [id1, id2] = state.flippedIds;
  const c1 = state.cards.find(c => c.id === id1);
  const c2 = state.cards.find(c => c.id === id2);
  const el1 = boardEl.querySelector(`[data-id="${id1}"]`);
  const el2 = boardEl.querySelector(`[data-id="${id2}"]`);

  if (c1.pairId === c2.pairId) {
    c1.matched = true;
    c2.matched = true;
    if (el1) el1.classList.add("matched");
    if (el2) el2.classList.add("matched");
    speak(c1.word);
    state.matchedCount += 1;

    if (state.matchedCount === state.totalPairs) {
      setTimeout(showCelebration, 400);
    }
  } else {
    c1.flipped = false;
    c2.flipped = false;
    if (el1) { el1.classList.add("shake"); }
    if (el2) { el2.classList.add("shake"); }
    setTimeout(() => {
      if (el1) { el1.classList.remove("flipped", "shake"); }
      if (el2) { el2.classList.remove("flipped", "shake"); }
    }, 400);
  }

  state.flippedIds = [];
  state.lockBoard = false;
}

function showCelebration() {
  celebrateOverlay.classList.add("show");
}

function hideCelebration() {
  celebrateOverlay.classList.remove("show");
}

function startNewGame() {
  hideCelebration();
  state.cards = buildDeck();
  state.flippedIds = [];
  state.matchedCount = 0;
  state.totalPairs = state.pairCount;
  state.lockBoard = false;
  renderBoard();
}

/* =========================================================================
   UI WIRING
   ========================================================================= */

function setActive(selector, matchFn) {
  document.querySelectorAll(selector).forEach(btn => {
    btn.classList.toggle("active", matchFn(btn));
  });
}

function refreshControlHighlights() {
  setActive(".mode-btn", btn => btn.dataset.mode === state.mode);
  setActive(".cat-btn", btn => btn.dataset.cat === state.category);
  setActive(".diff-btn", btn => Number(btn.dataset.pairs) === state.pairCount);
  document.getElementById("category-row").style.display =
    state.mode === "picture" ? "flex" : "none";
}

document.querySelectorAll(".mode-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    state.mode = btn.dataset.mode;
    refreshControlHighlights();
    startNewGame();
  });
});

document.querySelectorAll(".cat-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    state.category = btn.dataset.cat;
    refreshControlHighlights();
    startNewGame();
  });
});

document.querySelectorAll(".diff-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    state.pairCount = Number(btn.dataset.pairs);
    refreshControlHighlights();
    startNewGame();
  });
});

const soundBtn = document.getElementById("sound-toggle");
soundBtn.addEventListener("click", () => {
  state.soundOn = !state.soundOn;
  soundBtn.textContent = state.soundOn ? "🔊 Sound: On" : "🔇 Sound: Off";
  soundBtn.classList.toggle("muted", !state.soundOn);
});

document.getElementById("new-game-btn").addEventListener("click", startNewGame);
document.getElementById("celebrate-newgame-btn").addEventListener("click", startNewGame);

/* =========================================================================
   INIT
   ========================================================================= */

refreshControlHighlights();
startNewGame();
</script>
